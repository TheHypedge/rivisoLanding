# Copy to .env.local for local dev. On Vercel, add the same keys in Project Settings → Environment Variables.

WAITLIST_NOTIFY_EMAIL=info@thehypedge.com

# Hostinger SMTP (hPanel → Emails → Connect apps)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=team@thehypedge.com
# Use quotes if the password contains # @ ! or spaces
SMTP_PASS="your-mailbox-password"
SMTP_FROM="Riviso Waitlist <team@thehypedge.com>"

# If port 465 fails, use TLS:
# SMTP_PORT=587
# SMTP_SECURE=false
